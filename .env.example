# Build-time configuration (Vite exposes only VITE_* variables to the browser).
# Copy to .env.local and fill in real values. Leave blank to show an honest
# "not configured" state instead of a fake one.

# Direct audio stream URL for "Listen live" (e.g. https://stream.zeno.fm/<mount-id>)
VITE_STREAM_URL=""

# Sales desk contacts used by the commercial inquiry form
VITE_SALES_EMAIL=""
# International format, digits only, e.g. 2547XXXXXXXX
VITE_SALES_WHATSAPP=""

# Public URL of the deployed site, no trailing slash (e.g. https://proposal.example.co.ke).
# Used to make link-preview tags (og:image, canonical) absolute for WhatsApp and email.
VITE_SITE_URL=""
